# Copy to .env.production on the server and replace every placeholder.
# Keep this file private; never commit real values.
DOMAIN=your-domain.example
PUBLIC_ORIGIN=https://your-domain.example
DATABASE_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_64_CHARACTERS

# Set true only for the first backend startup to create the initial schema.
# Immediately change to false after the API is healthy and restart backend.
DB_SCHEMA_SYNC=true
BOOTSTRAP_ADMIN=true
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
